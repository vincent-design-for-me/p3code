# Local-first build configuration.
# This fork ships no Clerk sign-in and no T3 Connect relay defaults, so builds have cloud
# features disabled. Do not add server-side secrets to this file.

# Optional: a relay you deploy yourself from `infra/relay`.
# T3CODE_RELAY_URL=https://relay.example.com

# Optional: signed macOS builds.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/app.provisionprofile
